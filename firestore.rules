rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsIncoming() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function hasPositiveAmount() {
      return request.resource.data.amount is number &&
          request.resource.data.amount > 0;
    }

    function hasPositiveTarget() {
      return request.resource.data.targetAmount is number &&
          request.resource.data.targetAmount > 0;
    }

    match /users/{userId} {
      allow read, update: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /transactions/{transactionId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming() && hasPositiveAmount();
      allow update: if ownsExisting() && ownsIncoming() && hasPositiveAmount();
    }

    match /incomes/{incomeId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming() && hasPositiveAmount();
      allow update: if ownsExisting() && ownsIncoming() && hasPositiveAmount();
    }

    match /budgets/{budgetId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming() && hasPositiveAmount();
      allow update: if ownsExisting() && ownsIncoming() && hasPositiveAmount();
    }

    match /goals/{goalId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming() && hasPositiveTarget();
      allow update: if ownsExisting() && ownsIncoming() && hasPositiveTarget();
    }

    match /recurring_transactions/{recurringId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming() && hasPositiveAmount();
      allow update: if ownsExisting() && ownsIncoming() && hasPositiveAmount();
    }

    match /notifications/{notificationId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming();
    }

    match /notification_alert_state/{stateId} {
      allow read, write: if signedIn() && stateId == request.auth.uid;
    }

    match /goal_templates/{templateId} {
      allow read: if signedIn();
      allow write: if false;

      match /usage/{userId} {
        allow read, write: if signedIn() && userId == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
