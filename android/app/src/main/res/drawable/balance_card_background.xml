<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fill layer inset by 1dp so the stroke doesn't get clipped -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <solid android:color="@color/widget_card_bg" />
            <corners android:radius="32dp" />
        </shape>
    </item>
    <!-- Stroke layer drawn on top, fully visible -->
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
            <corners android:radius="32dp" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_divider" />
        </shape>
    </item>
</layer-list>
