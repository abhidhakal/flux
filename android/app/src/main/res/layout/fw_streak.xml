<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fw_bg"
    android:orientation="horizontal"
    android:padding="14dp" android:gravity="center_vertical">
<ImageView
    android:id="@+id/fire"
    android:layout_width="52dp"
    android:layout_height="52dp"
    android:layout_marginEnd="0dp"
    android:padding="14dp"
    android:background="@drawable/fw_tile_warn_soft"
    android:tint="@color/fw_warn"
    android:scaleType="fitCenter"
    android:src="@drawable/fw_ic_flame" />
<LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:layout_weight="1"
    android:layout_marginStart="12dp">
<TextView
    android:id="@+id/days"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textSize="24sp"
    android:textColor="@color/fw_ink"
    android:maxLines="1"
    android:ellipsize="end"
    android:includeFontPadding="false"
    android:fontFamily="sans-serif-black" 
    android:text="4 days" />
<TextView
    android:id="@+id/l"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:textSize="12sp"
    android:textColor="@color/fw_ink2"
    android:maxLines="2"
    android:ellipsize="end"
    android:includeFontPadding="false"
    android:fontFamily="sans-serif-medium"
    android:text="no-spend streak" />
</LinearLayout>
</LinearLayout>
